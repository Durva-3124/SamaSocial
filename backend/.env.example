# LLM provider (OpenAI-compatible). Change these three to switch providers.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=llama-3.3-70b-versatile

# Local embedding model (downloaded on first use, ~90 MB)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Max file upload size in MB
MAX_UPLOAD_MB=25

# Session TTL in minutes (in-memory sessions expire after this)
SESSION_TTL_MINUTES=120

# Retrieval settings
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.30

# Optional: YouTube Data API v3 key (for resource enrichment in Task 2)
# YOUTUBE_API_KEY=your-youtube-key-here

# Optional: proxy URL used when YouTube rate-limits this server's IP
# YOUTUBE_PROXY=http://user:password@proxy.example.com:8080

# Optional: Tavily search API key (for resource enrichment in Task 2)
# TAVILY_API_KEY=your-tavily-key-here
