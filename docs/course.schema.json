{
  "$defs": {
    "Audience": {
      "description": "Target audience descriptor.",
      "properties": {
        "age_group": {
          "title": "Age Group",
          "type": "string"
        },
        "level": {
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ],
          "title": "Level",
          "type": "string"
        },
        "prior_knowledge": {
          "title": "Prior Knowledge",
          "type": "string"
        }
      },
      "required": [
        "age_group",
        "level",
        "prior_knowledge"
      ],
      "title": "Audience",
      "type": "object"
    },
    "Duration": {
      "description": "Course duration descriptor.",
      "properties": {
        "weeks": {
          "maximum": 52,
          "minimum": 1,
          "title": "Weeks",
          "type": "integer"
        },
        "sessions_per_week": {
          "maximum": 7,
          "minimum": 1,
          "title": "Sessions Per Week",
          "type": "integer"
        },
        "session_minutes": {
          "maximum": 240,
          "minimum": 15,
          "title": "Session Minutes",
          "type": "integer"
        }
      },
      "required": [
        "weeks",
        "sessions_per_week",
        "session_minutes"
      ],
      "title": "Duration",
      "type": "object"
    },
    "Lesson": {
      "description": "A single lesson within a module.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "duration_minutes": {
          "default": 30,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "difficulty": {
          "default": "beginner",
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "objectives": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Objectives",
          "type": "array"
        },
        "topics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "resources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "title": "Resources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "Lesson",
      "type": "object"
    },
    "Module": {
      "description": "A course module containing lessons.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "difficulty": {
          "default": "beginner",
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "prerequisites": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "lessons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Lesson"
          },
          "title": "Lessons",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "Module",
      "type": "object"
    },
    "Resource": {
      "description": "A learning resource linked to a lesson.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "type": {
          "default": "other",
          "enum": [
            "video",
            "article",
            "exercise",
            "other"
          ],
          "title": "Type",
          "type": "string"
        },
        "validated": {
          "default": false,
          "title": "Validated",
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "title": "Resource",
      "type": "object"
    }
  },
  "description": "The full generated course plan.",
  "properties": {
    "title": {
      "title": "Title",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "level": {
      "default": "beginner",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "title": "Level",
      "type": "string"
    },
    "total_weeks": {
      "default": 4,
      "title": "Total Weeks",
      "type": "integer"
    },
    "goals": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Goals",
      "type": "array"
    },
    "audience": {
      "anyOf": [
        {
          "$ref": "#/$defs/Audience"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "duration": {
      "anyOf": [
        {
          "$ref": "#/$defs/Duration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "modules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Module"
      },
      "title": "Modules",
      "type": "array"
    }
  },
  "required": [
    "title"
  ],
  "title": "Course",
  "type": "object"
}
